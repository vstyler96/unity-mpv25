# PSR-2-style rules adapted to C#. Read by Rider, Visual Studio, VS Code (C# Dev Kit) and `dotnet format`.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
max_line_length = 120

# Braces: classes, methods and properties on the next line; control structures on the same line.
csharp_new_line_before_open_brace = types,methods,properties
csharp_new_line_before_else = false
csharp_new_line_before_catch = false
csharp_new_line_before_finally = false

# Control structures always use braces.
csharp_prefer_braces = true:warning
dotnet_diagnostic.IDE0011.severity = warning

# Visibility must be declared on every member.
dotnet_style_require_accessibility_modifiers = always:warning
dotnet_diagnostic.IDE0040.severity = warning

# Visibility first, then static / readonly.
csharp_preferred_modifier_order = public,private,protected,internal,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,volatile,async:warning

# One space after control keywords, none inside parentheses.
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_parentheses = false

# Generated by Unity from InputSystem_Actions.inputactions: don't lint it.
[Assets/InputSystem_Actions.cs]
generated_code = true
